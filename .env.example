# Public browser configuration. Every VITE_ value is exposed to browser users.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_PAYSTACK_PUBLIC_KEY=

# Legacy browser-side Judge0 integration. Do not use a production/private API key.
# A server-side authenticated proxy is required before production use.
VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
VITE_JUDGE0_API_KEY=

# Server-only Supabase Edge Function configuration. Never add a VITE_ prefix.
# Configure these through the function's secret environment, not a frontend build.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
